# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.local
.env.*.local
.env.local.*
!.env.example

# typescript
*.tsbuildinfo

app-example

# generated native folders
# /ios is intentionally tracked as a committed baseline for Xcode Cloud, which
# needs a real .xcodeproj/scheme to detect at workflow-setup time. It is
# regenerated fresh on every Xcode Cloud run via ios/ci_scripts/ci_post_clone.sh,
# so local changes to it should not normally be committed by hand — run
# `expo prebuild --platform ios --clean` again and commit the result instead.
/ios/Pods
/ios/build
/ios/*.xcworkspace
/android

# Claude Code — dynamic model routing (written per-turn by route-classifier hook)
.claude/settings.local.json

# Diagnostic artifacts (ANR reports, emulator screenshots, Metro logs)
# Runtime logs can contain LiveKit room tokens and auth callbacks — never commit them.
anr-*.txt
emulator-*.png
expo-*.log
expo-*.err.log
.codex/live-watch/*.log
android-signing-local/
