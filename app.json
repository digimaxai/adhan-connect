{
  "expo": {
    "name": "Adhan Connect",
    "slug": "adhan-connect",
    "owner": "maksums-digital-agency",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "adhanconnect",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.maksumsdigitalagency.adhanconnect",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Adhan Connect needs microphone access for live Adhan broadcasts.",
        "NSCameraUsageDescription": "Adhan Connect's live broadcast feature is built on WebRTC, which may request camera access even though video broadcasting is not currently used.",
        "NSLocationWhenInUseUsageDescription": "Adhan Connect uses your location to find nearby mosques, calculate local prayer times, and check access to nearby live Adhan broadcasts.",
        "NSPhotoLibraryUsageDescription": "Adhan Connect needs photo library access so mosque admins can attach a cover image to events, campaigns, and notices.",
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.maksumsdigitalagency.adhanconnect",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECORD_AUDIO",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-font",
      "expo-image-picker",
      [
        "expo-notifications",
        {
          "defaultChannel": "adhan-alerts"
        }
      ],
      "expo-secure-store",
      [
        "./plugins/with-ios-pod-build-settings",
        {
          "deploymentTarget": "15.1"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "20092fdb-b6af-47f8-891a-42f343175678"
      }
    }
  }
}
