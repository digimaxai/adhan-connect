{
  "name": "adhan-connect",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client --lan",
    "start:dev-client:lan": "expo start --dev-client --lan",
    "start:dev-client:tunnel": "expo start --dev-client --tunnel",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "android:doctor": "powershell -ExecutionPolicy Bypass -File ./scripts/android-doctor.ps1",
    "android:phone": "powershell -ExecutionPolicy Bypass -File ./scripts/android-phone.ps1",
    "android:phone:reinstall": "powershell -ExecutionPolicy Bypass -File ./scripts/android-phone.ps1 -Reinstall",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "web": "expo start --web",
    "web:fast": "node ./scripts/start-web-fast.js --static",
    "web:fast:clear": "node ./scripts/start-web-fast.js --static --clear",
    "web:portal": "node ./scripts/start-web-fast.js --server",
    "web:portal:staging": "node ./scripts/start-web-fast.js --server --staging-dev-client",
    "web:portal:clear": "node ./scripts/start-web-fast.js --server --clear",
    "test:email:staging": "node ./scripts/test-staging-email.js",
    "test:live:contracts": "node ./scripts/test-live-regression-contracts.js",
    "test:notifications:safety": "node ./scripts/test-notification-safety-contracts.js",
    "audit:notifications:staging": "node ./scripts/audit-staging-notifications.mjs",
    "smoke:notifications:staging": "node ./scripts/smoke-staging-notification-dispatcher.mjs",
    "test:nearby:api": "node ./scripts/test-nearby-api.js",
    "configure:push-dispatch": "node ./scripts/configure-push-dispatch.mjs",
    "test:quran:api": "node ./scripts/test-quran-api.js",
    "test:devotional:api": "node ./scripts/test-devotional-api.js",
    "lint": "expo lint",
    "postinstall": "patch-package",
    "test:services": "node scripts/services/test-rules.js",
    "test:adhan-audio": "node scripts/test-adhan-audio.cjs",
    "test:adhan-audio:db": "node scripts/test-adhan-audio-db.cjs",
    "test:adhan-delivery": "node scripts/test-adhan-delivery.cjs",
    "test:adhan-delivery:dispatch": "node scripts/test-adhan-delivery-dispatch.cjs"
  },
  "dependencies": {
