# EAS upload allow/deny rules. Keep this aligned with .gitignore and explicitly
# exclude every local environment file, including tracked staging overrides.

.git/
node_modules/

.expo/
dist/
web-build/
expo-env.d.ts

.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store

.env
.env.*
.env.local
.env.local.*
!.env.example

*.tsbuildinfo
app-example/
/ios/
/android/

.claude/settings.local.json
.codex/
.agents/
supabase/.temp/

anr-*.txt
emulator-*.png
expo-metro-*.log
expo-metro-*.err.log
expo-portal-*.log
expo-portal-*.err.log
