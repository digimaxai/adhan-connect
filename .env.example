EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Prefer platform-specific callbacks. The legacy value remains supported when
# it is a native scheme on native or an http(s) URL on web.
EXPO_PUBLIC_SUPABASE_REDIRECT_URL_WEB=
EXPO_PUBLIC_SUPABASE_REDIRECT_URL_NATIVE=
EXPO_PUBLIC_SUPABASE_REDIRECT_URL=
EXPO_PUBLIC_APPLE_AUTH_ENABLED=false
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false
EXPO_PUBLIC_SOCIAL_LINKING_ENABLED=false
EXPO_PUBLIC_API_BASE_URL=http://<MAC_LAN_IP>:8081

# Server-side API routes and local scripts. Do not expose these with EXPO_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE=
SUPABASE_ACCESS_TOKEN=
EXPO_FORCE_WEBCONTAINER_ENV=0
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
# Required for every server-side HTTP(S) live-stream playback/probe. Use
# comma-separated exact hostnames; prefix a provider-controlled DNS suffix with
# `*.`. Do not include schemes, paths, credentials, or ports.
LIVE_STREAM_UPSTREAM_ALLOWED_HOSTS=

# Server-only account controls. Deletion remains fail-closed until every audit
# flag is true AND the matching enabled approval row exists in
# public.account_deletion_release_approvals.
ACCOUNT_TRUST_PROXY=false
ACCOUNT_DELETION_ENABLED=false
ACCOUNT_DELETION_SCHEMA_AUDITED=false
ACCOUNT_DELETION_STORAGE_AUDITED=false
ACCOUNT_DELETION_ORCHESTRATION_AUDITED=false
# Comma-separated buckets whose user-owned objects live under {auth-user-id}/,
# or the literal `none` only after the production Storage audit confirms that.
ACCOUNT_DELETION_STORAGE_BUCKETS=
ACCOUNT_DELETION_APPLE_REVOCATION_READY=false
ACCOUNT_DELETION_APPLE_REVOCATION_URL=
ACCOUNT_DELETION_APPLE_REVOCATION_SECRET=

# Server-only mosque discovery worker (never EXPO_PUBLIC_).
OPENAI_API_KEY=
MOSQUE_ASSISTANT_MODEL=gpt-4.1
MOSQUE_ASSISTANT_WORKER_ID=mosque-worker-1

# East London Mosque timetable API (server-only, never EXPO_PUBLIC_).
# Used when a mosque's prayer_source is set to 'elm'. Leave blank to skip ELM fetches.
LPT_API_KEY=

# Mosque request admin notifications (server-only, never EXPO_PUBLIC_).
# RESEND_API_KEY is already required for Supabase SMTP — the same key is reused here.
# Set all three to enable email alerts on new mosque requests; leave any blank to disable.
# MOSQUE_REQUEST_NOTIFY_EMAIL must be a verified Resend recipient or any address.
# MOSQUE_REQUEST_NOTIFY_FROM must be a verified Resend sender domain, e.g.:
#   Adhan Connect <noreply@yourdomain.com>
# MOSQUE_REQUEST_ADMIN_URL is the full URL of the admin requests page, used in the email CTA.
MOSQUE_REQUEST_NOTIFY_EMAIL=
MOSQUE_REQUEST_NOTIFY_FROM=
MOSQUE_REQUEST_ADMIN_URL=https://adhanconnect.com/admin/mosque-requests
